<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
<variables>
<variable id="seStake">Stake</variable>
<variable id="seInitialStake">InitialStake</variable>
<variable id="seStepCount">StepCount</variable>
<variable id="seMaxSteps">MaxSteps</variable>
<variable id="seMultiplier">Multiplier</variable>
<variable id="seSessionLoss">SessionLoss</variable>
<variable id="seTakeProfit">TakeProfit</variable>
<variable id="seMessage">Message</variable>
</variables>
<block type="trade_definition" id="seTradeDef" deletable="false" x="0" y="60">
<statement name="TRADE_OPTIONS">
<block type="trade_definition_market" id="seMarket" deletable="false" movable="false"><field name="MARKET_LIST">synthetic_index</field><field name="SUBMARKET_LIST">random_index</field><field name="SYMBOL_LIST">R_50</field>
<next><block type="trade_definition_tradetype" id="seTradeType" deletable="false" movable="false"><field name="TRADETYPECAT_LIST">digits</field><field name="TRADETYPE_LIST">overunder</field>
<next><block type="trade_definition_contracttype" id="seContractType" deletable="false" movable="false"><field name="TYPE_LIST">DIGITUNDER</field>
<next><block type="trade_definition_candleinterval" id="seCandle" deletable="false" movable="false"><field name="CANDLEINTERVAL_LIST">60</field>
<next><block type="trade_definition_restartbuysell" id="seRestartBuy" deletable="false" movable="false"><field name="TIME_MACHINE_ENABLED">FALSE</field>
<next><block type="trade_definition_restartonerror" id="seRestartErr" deletable="false" movable="false"><field name="RESTARTONERROR">TRUE</field></block></next>
</block></next></block></next></block></next></block></next></block>
</statement>
<statement name="INITIALIZATION">
<block type="variables_set" id="seSetInitial"><field name="VAR" id="seInitialStake">InitialStake</field><value name="VALUE"><block type="math_number" id="seNumInitial"><field name="NUM">3</field></block></value>
<next><block type="variables_set" id="seSetStake"><field name="VAR" id="seStake">Stake</field><value name="VALUE"><block type="variables_get" id="seGetInitial1"><field name="VAR" id="seInitialStake">InitialStake</field></block></value>
<next><block type="variables_set" id="seSetStep"><field name="VAR" id="seStepCount">StepCount</field><value name="VALUE"><block type="math_number" id="seNumStep"><field name="NUM">0</field></block></value>
<next><block type="variables_set" id="seSetMaxSteps"><field name="VAR" id="seMaxSteps">MaxSteps</field><value name="VALUE"><block type="math_number" id="seNumMaxSteps"><field name="NUM">4</field></block></value>
<next><block type="variables_set" id="seSetMult"><field name="VAR" id="seMultiplier">Multiplier</field><value name="VALUE"><block type="math_number" id="seNumMult"><field name="NUM">2</field></block></value>
<next><block type="variables_set" id="seSetSessionLoss"><field name="VAR" id="seSessionLoss">SessionLoss</field><value name="VALUE"><block type="math_number" id="seNumSessionLoss"><field name="NUM">60</field></block></value>
<next><block type="variables_set" id="seSetTakeProfit"><field name="VAR" id="seTakeProfit">TakeProfit</field><value name="VALUE"><block type="math_number" id="seNumTakeProfit"><field name="NUM">15</field></block></value></block></next>
</block></next></block></next></block></next></block></next></block></next></block>
</statement>
<statement name="SUBMARKET">
<block type="trade_definition_tradeoptions" id="seTradeOpts"><mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation><field name="DURATIONTYPE_LIST">t</field>
<value name="DURATION"><shadow type="math_number_positive" id="seShDuration"><field name="NUM">1</field></shadow></value>
<value name="AMOUNT"><shadow type="math_number_positive" id="seShAmount"><field name="NUM">3</field></shadow><block type="variables_get" id="seGetStakeAmt"><field name="VAR" id="seStake">Stake</field></block></value>
<value name="PREDICTION"><shadow type="math_number_positive" id="seShPrediction"><field name="NUM">8</field></shadow></value>
</block>
</statement>
</block>
<block type="before_purchase" id="seBeforePurchase" deletable="false" x="0" y="900">
<statement name="BEFOREPURCHASE_STACK"><block type="purchase" id="sePurchase"><field name="PURCHASE_LIST">DIGITUNDER</field></block></statement>
</block>
<block type="after_purchase" id="seAfterPurchase" x="0" y="1400">
<statement name="AFTERPURCHASE_STACK">
<block type="controls_if" id="seIfWin"><mutation else="1"></mutation>
<value name="IF0"><block type="contract_check_result" id="seCheckWin"><field name="CHECK_RESULT">win</field></block></value>
<statement name="DO0">
<block type="variables_set" id="seWinResetStake"><field name="VAR" id="seStake">Stake</field><value name="VALUE"><block type="variables_get" id="seGetInitial2"><field name="VAR" id="seInitialStake">InitialStake</field></block></value>
<next><block type="variables_set" id="seWinResetStep"><field name="VAR" id="seStepCount">StepCount</field><value name="VALUE"><block type="math_number" id="seNumZeroWin"><field name="NUM">0</field></block></value></block></next>
</block>
</statement>
<statement name="ELSE">
<block type="variables_set" id="seLossIncStep"><field name="VAR" id="seStepCount">StepCount</field>
<value name="VALUE"><block type="math_arithmetic" id="seStepPlusOne"><field name="OP">ADD</field>
<value name="A"><shadow type="math_number" id="seShStepA"><field name="NUM">0</field></shadow><block type="variables_get" id="seGetStep1"><field name="VAR" id="seStepCount">StepCount</field></block></value>
<value name="B"><shadow type="math_number" id="seShStepB"><field name="NUM">1</field></shadow></value>
</block></value>
<next>
<block type="controls_if" id="seIfCapped"><mutation else="1"></mutation>
<value name="IF0"><block type="logic_compare" id="seCmpStep"><field name="OP">GTE</field>
<value name="A"><block type="variables_get" id="seGetStep2"><field name="VAR" id="seStepCount">StepCount</field></block></value>
<value name="B"><block type="variables_get" id="seGetMaxSteps"><field name="VAR" id="seMaxSteps">MaxSteps</field></block></value>
</block></value>
<statement name="DO0">
<block type="variables_set" id="seCapResetStake"><field name="VAR" id="seStake">Stake</field><value name="VALUE"><block type="variables_get" id="seGetInitial3"><field name="VAR" id="seInitialStake">InitialStake</field></block></value>
<next><block type="variables_set" id="seCapResetStep"><field name="VAR" id="seStepCount">StepCount</field><value name="VALUE"><block type="math_number" id="seNumZeroCap"><field name="NUM">0</field></block></value>
<next><block type="notify" id="seNotifyCap"><field name="NOTIFICATION_TYPE">warn</field><field name="NOTIFICATION_SOUND">silent</field><value name="MESSAGE"><shadow type="text" id="seShCapMsg"><field name="TEXT">Escalation cap reached - back to base stake.</field></shadow></value></block></next>
</block></next>
</block>
</statement>
<statement name="ELSE">
<block type="variables_set" id="seStepUpStake"><field name="VAR" id="seStake">Stake</field>
<value name="VALUE"><block type="math_arithmetic" id="seStakeTimesMult"><field name="OP">MULTIPLY</field>
<value name="A"><shadow type="math_number" id="seShMultA"><field name="NUM">1</field></shadow><block type="variables_get" id="seGetStake2"><field name="VAR" id="seStake">Stake</field></block></value>
<value name="B"><shadow type="math_number" id="seShMultB"><field name="NUM">1</field></shadow><block type="variables_get" id="seGetMult"><field name="VAR" id="seMultiplier">Multiplier</field></block></value>
</block></value>
</block>
</statement>
</block>
</next>
</block>
</statement>
<next>
<block type="controls_if" id="seIfTakeProfit"><mutation else="1"></mutation>
<value name="IF0"><block type="logic_compare" id="seCmpTP"><field name="OP">GTE</field>
<value name="A"><block type="total_profit" id="seTotalProfitTP"></block></value>
<value name="B"><block type="variables_get" id="seGetTakeProfit"><field name="VAR" id="seTakeProfit">TakeProfit</field></block></value>
</block></value>
<statement name="DO0">
<block type="notify" id="seNotifyTP"><field name="NOTIFICATION_TYPE">success</field><field name="NOTIFICATION_SOUND">earned-money</field><value name="MESSAGE"><shadow type="text" id="seShTPMsg"><field name="TEXT">Take profit reached - stopping while ahead.</field></shadow></value></block>
</statement>
<statement name="ELSE">
<block type="controls_if" id="seIfSessionStop"><mutation else="1"></mutation>
<value name="IF0"><block type="logic_compare" id="seCmpSession"><field name="OP">LTE</field>
<value name="A"><block type="total_profit" id="seTotalProfit"></block></value>
<value name="B"><block type="math_arithmetic" id="seNegSessionLoss"><field name="OP">MINUS</field>
<value name="A"><shadow type="math_number" id="seShNegA"><field name="NUM">0</field></shadow><block type="math_number" id="seNumZeroNeg"><field name="NUM">0</field></block></value>
<value name="B"><shadow type="math_number" id="seShNegB"><field name="NUM">0</field></shadow><block type="variables_get" id="seGetSessionLoss"><field name="VAR" id="seSessionLoss">SessionLoss</field></block></value>
</block></value>
</block></value>
<statement name="DO0">
<block type="text_join" id="seJoinStop"><field name="VARIABLE" id="seMessage">Message</field>
<statement name="STACK">
<block type="text_statement" id="seStopTxt1"><value name="TEXT"><shadow type="text" id="seShStop1"><field name="TEXT">Session loss limit hit at</field></shadow></value>
<next><block type="text_statement" id="seStopTxt2"><value name="TEXT"><block type="total_profit" id="seTotalProfit2"></block></value>
<next><block type="text_statement" id="seStopTxt3"><value name="TEXT"><shadow type="text" id="seShStop3"><field name="TEXT">- stopping to protect the balance.</field></shadow></value></block></next>
</block></next>
</block>
</statement>
</block>
<next><block type="notify" id="seNotifyStop"><field name="NOTIFICATION_TYPE">error</field><field name="NOTIFICATION_SOUND">severe-error</field><value name="MESSAGE"><block type="variables_get" id="seGetMsgStop"><field name="VAR" id="seMessage">Message</field></block></value></block></next>
</statement>
<statement name="ELSE"><block type="trade_again" id="seTradeAgain"></block></statement>
</block>
</statement>
</block>
</next>
</block>
</statement>
</block>
</xml>
