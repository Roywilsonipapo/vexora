<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
<variables>
<variable id="vgStake">Stake</variable>
<variable id="vgInitialStake">InitialStake</variable>
<variable id="vgEntryCeiling">EntryCeiling</variable>
<variable id="vgSkipped">Skipped</variable>
<variable id="vgSessionLoss">SessionLoss</variable>
<variable id="vgTakeProfit">TakeProfit</variable>
<variable id="vgMessage">Message</variable>
</variables>
<block type="trade_definition" id="vgTradeDef" deletable="false" x="0" y="60">
<statement name="TRADE_OPTIONS">
<block type="trade_definition_market" id="vgMarket" deletable="false" movable="false"><field name="MARKET_LIST">synthetic_index</field><field name="SUBMARKET_LIST">random_index</field><field name="SYMBOL_LIST">1HZ100V</field>
<next><block type="trade_definition_tradetype" id="vgTradeType" deletable="false" movable="false"><field name="TRADETYPECAT_LIST">digits</field><field name="TRADETYPE_LIST">overunder</field>
<next><block type="trade_definition_contracttype" id="vgContractType" deletable="false" movable="false"><field name="TYPE_LIST">DIGITOVER</field>
<next><block type="trade_definition_candleinterval" id="vgCandle" deletable="false" movable="false"><field name="CANDLEINTERVAL_LIST">60</field>
<next><block type="trade_definition_restartbuysell" id="vgRestartBuy" deletable="false" movable="false"><field name="TIME_MACHINE_ENABLED">FALSE</field>
<next><block type="trade_definition_restartonerror" id="vgRestartErr" deletable="false" movable="false"><field name="RESTARTONERROR">TRUE</field></block></next>
</block></next></block></next></block></next></block></next></block>
</statement>
<statement name="INITIALIZATION">
<block type="variables_set" id="vgSetInitial"><field name="VAR" id="vgInitialStake">InitialStake</field><value name="VALUE"><block type="math_number" id="vgNumInitial"><field name="NUM">1</field></block></value>
<next><block type="variables_set" id="vgSetStake"><field name="VAR" id="vgStake">Stake</field><value name="VALUE"><block type="variables_get" id="vgGetInitial1"><field name="VAR" id="vgInitialStake">InitialStake</field></block></value>
<next><block type="variables_set" id="vgSetCeiling"><field name="VAR" id="vgEntryCeiling">EntryCeiling</field><value name="VALUE"><block type="math_number" id="vgNumCeiling"><field name="NUM">3</field></block></value>
<next><block type="variables_set" id="vgSetSkipped"><field name="VAR" id="vgSkipped">Skipped</field><value name="VALUE"><block type="math_number" id="vgNumSkipped"><field name="NUM">0</field></block></value>
<next><block type="variables_set" id="vgSetSessionLoss"><field name="VAR" id="vgSessionLoss">SessionLoss</field><value name="VALUE"><block type="math_number" id="vgNumSessionLoss"><field name="NUM">12</field></block></value>
<next><block type="variables_set" id="vgSetTakeProfit"><field name="VAR" id="vgTakeProfit">TakeProfit</field><value name="VALUE"><block type="math_number" id="vgNumTakeProfit"><field name="NUM">6</field></block></value></block></next>
</block></next></block></next></block></next></block></next></block>
</statement>
<statement name="SUBMARKET">
<block type="trade_definition_tradeoptions" id="vgTradeOpts"><mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation><field name="DURATIONTYPE_LIST">t</field>
<value name="DURATION"><shadow type="math_number_positive" id="vgShDuration"><field name="NUM">1</field></shadow></value>
<value name="AMOUNT"><shadow type="math_number_positive" id="vgShAmount"><field name="NUM">1</field></shadow><block type="variables_get" id="vgGetStakeAmt"><field name="VAR" id="vgStake">Stake</field></block></value>
<value name="PREDICTION"><shadow type="math_number_positive" id="vgShPrediction"><field name="NUM">1</field></shadow></value>
</block>
</statement>
</block>
<block type="before_purchase" id="vgBeforePurchase" deletable="false" x="0" y="900">
<statement name="BEFOREPURCHASE_STACK">
<block type="controls_if" id="vgIfGate"><mutation else="1"></mutation>
<value name="IF0">
<block type="logic_operation" id="vgAndGate"><field name="OP">AND</field>
<value name="A"><block type="logic_compare" id="vgCmpDigit"><field name="OP">LTE</field>
<value name="A"><block type="last_digit" id="vgLastDigit"></block></value>
<value name="B"><block type="variables_get" id="vgGetCeiling"><field name="VAR" id="vgEntryCeiling">EntryCeiling</field></block></value>
</block></value>
<value name="B"><block type="check_direction" id="vgCheckDir"><field name="CHECK_DIRECTION">fall</field></block></value>
</block>
</value>
<statement name="DO0">
<block type="variables_set" id="vgResetSkipped"><field name="VAR" id="vgSkipped">Skipped</field><value name="VALUE"><block type="math_number" id="vgNumZeroSkip"><field name="NUM">0</field></block></value>
<next><block type="purchase" id="vgPurchase"><field name="PURCHASE_LIST">DIGITOVER</field></block></next>
</block>
</statement>
<statement name="ELSE">
<block type="variables_set" id="vgIncSkipped"><field name="VAR" id="vgSkipped">Skipped</field>
<value name="VALUE"><block type="math_arithmetic" id="vgSkipPlus"><field name="OP">ADD</field>
<value name="A"><shadow type="math_number" id="vgShSkipA"><field name="NUM">0</field></shadow><block type="variables_get" id="vgGetSkipped"><field name="VAR" id="vgSkipped">Skipped</field></block></value>
<value name="B"><shadow type="math_number" id="vgShSkipB"><field name="NUM">1</field></shadow></value>
</block></value>
</block>
</statement>
</block>
</statement>
</block>
<block type="after_purchase" id="vgAfterPurchase" x="0" y="1400">
<statement name="AFTERPURCHASE_STACK">
<block type="controls_if" id="vgIfWin"><mutation else="1"></mutation>
<value name="IF0"><block type="contract_check_result" id="vgCheckWin"><field name="CHECK_RESULT">win</field></block></value>
<statement name="DO0">
<block type="variables_set" id="vgWinStake"><field name="VAR" id="vgStake">Stake</field><value name="VALUE"><block type="variables_get" id="vgGetInitial2"><field name="VAR" id="vgInitialStake">InitialStake</field></block></value></block>
</statement>
<statement name="ELSE">
<block type="variables_set" id="vgLossStake"><field name="VAR" id="vgStake">Stake</field><value name="VALUE"><block type="variables_get" id="vgGetInitial3"><field name="VAR" id="vgInitialStake">InitialStake</field></block></value></block>
</statement>
<next>
<block type="controls_if" id="vgIfTP"><mutation else="1"></mutation>
<value name="IF0"><block type="logic_compare" id="vgCmpTP"><field name="OP">GTE</field>
<value name="A"><block type="total_profit" id="vgTotalProfit1"></block></value>
<value name="B"><block type="variables_get" id="vgGetTakeProfit"><field name="VAR" id="vgTakeProfit">TakeProfit</field></block></value>
</block></value>
<statement name="DO0">
<block type="notify" id="vgNotifyTP"><field name="NOTIFICATION_TYPE">success</field><field name="NOTIFICATION_SOUND">earned-money</field><value name="MESSAGE"><shadow type="text" id="vgShTPMsg"><field name="TEXT">Volatility-Gated Entry: take profit reached - stopping.</field></shadow></value></block>
</statement>
<statement name="ELSE">
<block type="controls_if" id="vgIfStop"><mutation else="1"></mutation>
<value name="IF0"><block type="logic_compare" id="vgCmpStop"><field name="OP">LTE</field>
<value name="A"><block type="total_profit" id="vgTotalProfit2"></block></value>
<value name="B"><block type="math_arithmetic" id="vgNegLoss"><field name="OP">MINUS</field>
<value name="A"><shadow type="math_number" id="vgShNegA"><field name="NUM">0</field></shadow><block type="math_number" id="vgNumZeroNeg"><field name="NUM">0</field></block></value>
<value name="B"><shadow type="math_number" id="vgShNegB"><field name="NUM">0</field></shadow><block type="variables_get" id="vgGetSessionLoss"><field name="VAR" id="vgSessionLoss">SessionLoss</field></block></value>
</block></value>
</block></value>
<statement name="DO0">
<block type="notify" id="vgNotifyStop"><field name="NOTIFICATION_TYPE">error</field><field name="NOTIFICATION_SOUND">severe-error</field><value name="MESSAGE"><shadow type="text" id="vgShStopMsg"><field name="TEXT">Volatility-Gated Entry: session loss limit hit - stopping.</field></shadow></value></block>
</statement>
<statement name="ELSE"><block type="trade_again" id="vgTradeAgain"></block></statement>
</block>
</statement>
</block>
</next>
</block>
</statement>
</block>
</xml>
