<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
<variables>
<variable id="cbStake">Stake</variable>
<variable id="cbInitialStake">InitialStake</variable>
<variable id="cbMinStake">MinStake</variable>
<variable id="cbLossStreak">LossStreak</variable>
<variable id="cbStreakLimit">StreakLimit</variable>
<variable id="cbCoolLeft">CoolLeft</variable>
<variable id="cbCoolRounds">CoolRounds</variable>
<variable id="cbSessionLoss">SessionLoss</variable>
<variable id="cbMessage">Message</variable>
</variables>
<block type="trade_definition" id="cbTradeDef" deletable="false" x="0" y="60">
<statement name="TRADE_OPTIONS">
<block type="trade_definition_market" id="cbMarket" deletable="false" movable="false"><field name="MARKET_LIST">synthetic_index</field><field name="SUBMARKET_LIST">random_index</field><field name="SYMBOL_LIST">1HZ100V</field>
<next><block type="trade_definition_tradetype" id="cbTradeType" deletable="false" movable="false"><field name="TRADETYPECAT_LIST">digits</field><field name="TRADETYPE_LIST">overunder</field>
<next><block type="trade_definition_contracttype" id="cbContractType" deletable="false" movable="false"><field name="TYPE_LIST">both</field>
<next><block type="trade_definition_candleinterval" id="cbCandle" deletable="false" movable="false"><field name="CANDLEINTERVAL_LIST">60</field>
<next><block type="trade_definition_restartbuysell" id="cbRestartBuy" deletable="false" movable="false"><field name="TIME_MACHINE_ENABLED">FALSE</field>
<next><block type="trade_definition_restartonerror" id="cbRestartErr" deletable="false" movable="false"><field name="RESTARTONERROR">TRUE</field></block></next>
</block></next></block></next></block></next></block></next></block>
</statement>
<statement name="INITIALIZATION">
<block type="variables_set" id="cbSetInitial"><field name="VAR" id="cbInitialStake">InitialStake</field><value name="VALUE"><block type="math_number" id="cbNumInitial"><field name="NUM">1</field></block></value>
<next><block type="variables_set" id="cbSetMin"><field name="VAR" id="cbMinStake">MinStake</field><value name="VALUE"><block type="math_number" id="cbNumMin"><field name="NUM">0.35</field></block></value>
<next><block type="variables_set" id="cbSetStake"><field name="VAR" id="cbStake">Stake</field><value name="VALUE"><block type="variables_get" id="cbGetInitial1"><field name="VAR" id="cbInitialStake">InitialStake</field></block></value>
<next><block type="variables_set" id="cbSetStreak"><field name="VAR" id="cbLossStreak">LossStreak</field><value name="VALUE"><block type="math_number" id="cbNumStreak"><field name="NUM">0</field></block></value>
<next><block type="variables_set" id="cbSetLimit"><field name="VAR" id="cbStreakLimit">StreakLimit</field><value name="VALUE"><block type="math_number" id="cbNumLimit"><field name="NUM">3</field></block></value>
<next><block type="variables_set" id="cbSetCoolLeft"><field name="VAR" id="cbCoolLeft">CoolLeft</field><value name="VALUE"><block type="math_number" id="cbNumCoolLeft"><field name="NUM">0</field></block></value>
<next><block type="variables_set" id="cbSetCoolRounds"><field name="VAR" id="cbCoolRounds">CoolRounds</field><value name="VALUE"><block type="math_number" id="cbNumCoolRounds"><field name="NUM">5</field></block></value>
<next><block type="variables_set" id="cbSetSessionLoss"><field name="VAR" id="cbSessionLoss">SessionLoss</field><value name="VALUE"><block type="math_number" id="cbNumSessionLoss"><field name="NUM">15</field></block></value></block></next>
</block></next></block></next></block></next></block></next></block></next></block></next></block>
</statement>
<statement name="SUBMARKET">
<block type="trade_definition_tradeoptions" id="cbTradeOpts"><mutation has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation><field name="DURATIONTYPE_LIST">t</field>
<value name="DURATION"><shadow type="math_number_positive" id="cbShDuration"><field name="NUM">1</field></shadow></value>
<value name="AMOUNT"><shadow type="math_number_positive" id="cbShAmount"><field name="NUM">1</field></shadow><block type="variables_get" id="cbGetStakeAmt"><field name="VAR" id="cbStake">Stake</field></block></value>
<value name="PREDICTION"><shadow type="math_number_positive" id="cbShPrediction"><field name="NUM">1</field></shadow></value>
</block>
</statement>
</block>
<block type="before_purchase" id="cbBeforePurchase" deletable="false" x="0" y="900">
<statement name="BEFOREPURCHASE_STACK"><block type="purchase" id="cbPurchase"><field name="PURCHASE_LIST">DIGITOVER</field></block></statement>
</block>
<block type="after_purchase" id="cbAfterPurchase" x="0" y="1400">
<statement name="AFTERPURCHASE_STACK">
<block type="controls_if" id="cbIfWin"><mutation else="1"></mutation>
<value name="IF0"><block type="contract_check_result" id="cbCheckWin"><field name="CHECK_RESULT">win</field></block></value>
<statement name="DO0">
<block type="variables_set" id="cbWinResetStreak"><field name="VAR" id="cbLossStreak">LossStreak</field><value name="VALUE"><block type="math_number" id="cbNumZeroWin"><field name="NUM">0</field></block></value></block>
</statement>
<statement name="ELSE">
<block type="variables_set" id="cbLossIncStreak"><field name="VAR" id="cbLossStreak">LossStreak</field>
<value name="VALUE"><block type="math_arithmetic" id="cbStreakPlus"><field name="OP">ADD</field>
<value name="A"><shadow type="math_number" id="cbShStreakA"><field name="NUM">0</field></shadow><block type="variables_get" id="cbGetStreak1"><field name="VAR" id="cbLossStreak">LossStreak</field></block></value>
<value name="B"><shadow type="math_number" id="cbShStreakB"><field name="NUM">1</field></shadow></value>
</block></value>
<next>
<block type="controls_if" id="cbIfTrip">
<value name="IF0"><block type="logic_compare" id="cbCmpStreak"><field name="OP">GTE</field>
<value name="A"><block type="variables_get" id="cbGetStreak2"><field name="VAR" id="cbLossStreak">LossStreak</field></block></value>
<value name="B"><block type="variables_get" id="cbGetLimit"><field name="VAR" id="cbStreakLimit">StreakLimit</field></block></value>
</block></value>
<statement name="DO0">
<block type="variables_set" id="cbTripCool"><field name="VAR" id="cbCoolLeft">CoolLeft</field><value name="VALUE"><block type="variables_get" id="cbGetCoolRounds"><field name="VAR" id="cbCoolRounds">CoolRounds</field></block></value>
<next><block type="variables_set" id="cbTripResetStreak"><field name="VAR" id="cbLossStreak">LossStreak</field><value name="VALUE"><block type="math_number" id="cbNumZeroTrip"><field name="NUM">0</field></block></value>
<next><block type="notify" id="cbNotifyTrip"><field name="NOTIFICATION_TYPE">warn</field><field name="NOTIFICATION_SOUND">silent</field><value name="MESSAGE"><shadow type="text" id="cbShTripMsg"><field name="TEXT">Loss streak hit the limit - cooling down at minimum stake.</field></shadow></value></block></next>
</block></next>
</block>
</statement>
</block>
</next>
</block>
</statement>
<next>
<block type="controls_if" id="cbIfCooling"><mutation else="1"></mutation>
<value name="IF0"><block type="logic_compare" id="cbCmpCool"><field name="OP">GT</field>
<value name="A"><block type="variables_get" id="cbGetCoolLeft1"><field name="VAR" id="cbCoolLeft">CoolLeft</field></block></value>
<value name="B"><block type="math_number" id="cbNumZeroCmp"><field name="NUM">0</field></block></value>
</block></value>
<statement name="DO0">
<block type="variables_set" id="cbCoolStake"><field name="VAR" id="cbStake">Stake</field><value name="VALUE"><block type="variables_get" id="cbGetMin"><field name="VAR" id="cbMinStake">MinStake</field></block></value>
<next><block type="variables_set" id="cbCoolDec"><field name="VAR" id="cbCoolLeft">CoolLeft</field>
<value name="VALUE"><block type="math_arithmetic" id="cbCoolMinus"><field name="OP">MINUS</field>
<value name="A"><shadow type="math_number" id="cbShCoolA"><field name="NUM">0</field></shadow><block type="variables_get" id="cbGetCoolLeft2"><field name="VAR" id="cbCoolLeft">CoolLeft</field></block></value>
<value name="B"><shadow type="math_number" id="cbShCoolB"><field name="NUM">1</field></shadow></value>
</block></value>
</block></next>
</block>
</statement>
<statement name="ELSE">
<block type="variables_set" id="cbNormalStake"><field name="VAR" id="cbStake">Stake</field><value name="VALUE"><block type="variables_get" id="cbGetInitial2"><field name="VAR" id="cbInitialStake">InitialStake</field></block></value></block>
</statement>
<next>
<block type="controls_if" id="cbIfSessionStop"><mutation else="1"></mutation>
<value name="IF0"><block type="logic_compare" id="cbCmpSession"><field name="OP">LTE</field>
<value name="A"><block type="total_profit" id="cbTotalProfit"></block></value>
<value name="B"><block type="math_arithmetic" id="cbNegLoss"><field name="OP">MINUS</field>
<value name="A"><shadow type="math_number" id="cbShNegA"><field name="NUM">0</field></shadow><block type="math_number" id="cbNumZeroNeg"><field name="NUM">0</field></block></value>
<value name="B"><shadow type="math_number" id="cbShNegB"><field name="NUM">0</field></shadow><block type="variables_get" id="cbGetSessionLoss"><field name="VAR" id="cbSessionLoss">SessionLoss</field></block></value>
</block></value>
</block></value>
<statement name="DO0">
<block type="notify" id="cbNotifyStop"><field name="NOTIFICATION_TYPE">error</field><field name="NOTIFICATION_SOUND">severe-error</field><value name="MESSAGE"><shadow type="text" id="cbShStopMsg"><field name="TEXT">Cool-Down Circuit Breaker: session loss limit hit - stopping.</field></shadow></value></block>
</statement>
<statement name="ELSE"><block type="trade_again" id="cbTradeAgain"></block></statement>
</block>
</next>
</block>
</next>
</block>
</statement>
</block>
</xml>
